#lang scribble/manual

@(require "reader.rkt")

@title{Reader command rendering check}

The CPU option is @command-text["--renderer raster"].
The GPU option is @command-text["--renderer gpu"].
The count option is @command-text["--count 300"].
The snapshot option is @command-text["--snapshot picture.png"].
The list command is @command-text["raco skia-examples --list"].
