<?xml version="1.0"?>
<!-- Skia generation 1 natipkg defaults. Original configuration, MIT licensed.
     The lazy loader materializes escaped absolute paths into the addon cache.
     Fonts are supplied by the declared draw-ttf native dependency. -->
<fontconfig>
  @FONT_DIRECTORIES@
  <cachedir>@CACHE_DIRECTORY@</cachedir>
  <alias><family>sans-serif</family><prefer><family>FreeSans</family></prefer></alias>
  <alias><family>sans</family><prefer><family>FreeSans</family></prefer></alias>
  <alias><family>serif</family><prefer><family>FreeSerif</family></prefer></alias>
  <alias><family>monospace</family><prefer><family>FreeMono</family></prefer></alias>
  <!-- Skia m119 checks that the chosen face matches a family in the pattern.
       Racket's minimal configuration leaves an unnamed pattern without one. -->
  <match target="pattern">
    <edit name="family" mode="append_last" binding="weak"><string>FreeSans</string></edit>
  </match>
</fontconfig>
