#lang racket/base

;; Installed, CPU-only validation. Dynamic Draw loading makes both fontconfig /
;; Pango and Skia initialization orders observable in separate fresh processes.
;; No work runs on import; binary-library packages retain this entry point.
(require json racket/class racket/cmdline racket/file racket/path
         setup/getinfo
         "../main.rkt" "../private/native-loader.rkt"
         "../private/harfbuzz-native.rkt" "../private/native-package-paths.rkt"
         "../private/catalog-fonts.rkt")

(define (ensure condition message)
  (unless condition (error 'catalog-smoke "~a" message)))

(define (draw-text!)
  (define bitmap ((dynamic-require 'racket/draw 'make-bitmap) 48 24))
  (define dc (new (dynamic-require 'racket/draw 'bitmap-dc%) [bitmap bitmap]))
  (send dc clear)
  (send dc draw-text "AV" 1 1)
  (send dc set-bitmap #f)
  (define pixels (make-bytes (* 48 24 4)))
  (send bitmap get-argb-pixels 0 0 48 24 pixels)
  (ensure (for/or ([i (in-range 0 (bytes-length pixels) 4)])
            (< (bytes-ref pixels (+ i 1)) 200)) "Racket Draw text produced no ink"))

(define (library-evidence report)
  (define path (hash-ref report 'absolute_path))
  (hash-set report 'installed_sha256 (and path (native-file-sha256 path))))

(module+ main
  (define draw-first? #f)
  (command-line #:once-each [("--draw-first") "Initialize Racket Draw text before Skia" (set! draw-first? #t)])
  (ensure (and (not (getenv "RACKET_SKIA_LIBRARY")) (not (getenv "RACKET_HARFBUZZ_LIBRARY")))
          "catalog validation forbids native overrides")
  (when draw-first? (draw-text!))
  (skia-check!) (harfbuzz-check!)
  (with-skia ([surface (make-surface 9 7 #:background (rgb 7 11 17))]
              [paint (make-paint #:color (rgb 231 53 79) #:antialias? #f)]
              [font (make-font #:size 16)])
    (draw-rect (surface-canvas surface) 1 2 4 3 paint)
    (ensure (equal? (surface-pixel surface 2 3) (rgb 231 53 79)) "interior pixel differs")
    (ensure (equal? (surface-pixel surface 8 0) (rgb 7 11 17)) "asymmetric background differs")
    (with-skia ([decoded (image-from-bytes (surface->png-bytes surface))])
      (ensure (equal? (image->rgba-bytes decoded) (surface->rgba-bytes surface)) "PNG pixels differ"))
    ;; Exercises the real platform default manager, including natipkg's declared
    ;; FreeSans support. Script coverage below uses separately declared Noto data.
    (ensure (for/and ([g (in-vector (font-text->glyphs font "AV"))]) (positive? g))
            "declared platform default font support has no Latin glyphs"))
  (unless draw-first? (draw-text!))
  (define shapes
    (for/list ([filename '("NotoSans-Regular.ttf" "NotoSansArabic-Regular.ttf"
                           "NotoSansHebrew-Regular.ttf" "NotoSansCJKjp-Regular.otf")]
               [text '("AV" "مرحبا بالعالم" "שלום" "日本語中文ひらがな")])
      (with-skia ([face (typeface-from-file (catalog-font-path filename))]
                  [font (make-font face #:size 20)] [shaper (make-shaper font)])
        (ensure (for/and ([g (in-vector (font-text->glyphs font text))]) (positive? g))
                (format "missing declared script glyphs: ~a" filename))
        (define run (shape-text shaper text))
        (ensure (and (positive? (shaped-run-glyph-count run)) (positive? (shaped-run-advance-x run)))
                "HarfBuzz produced no positioned glyphs")
        (hasheq 'font filename 'font_sha256 (native-file-sha256 (catalog-font-path filename))
                'glyphs (vector->list (shaped-run-glyphs run)) 'advance (shaped-run-advance-x run)))))
  (define skia (native-library-report))
  (define configuration (hash-ref skia 'fontconfig))
  (when (and configuration (equal? (hash-ref configuration 'origin) "managed-cache"))
    (for ([path-key '(template_path materialized_path)]
          [digest-key '(template_sha256 materialized_sha256)])
      (ensure (equal? (native-file-sha256 (hash-ref configuration path-key))
                      (hash-ref configuration digest-key))
              "fontconfig provenance differs from installed/generated bytes")))
  (define skia-loader (library-evidence (hash-ref skia 'loader)))
  (define harfbuzz (library-evidence (harfbuzz-library-report)))
  (for ([report (list skia-loader harfbuzz)])
    (ensure (equal? (hash-ref report 'origin) "managed") "catalog smoke did not select managed libraries")
    (ensure (equal? (path-only (string->path (hash-ref report 'absolute_path)))
                    (path->directory-path (string->path (hash-ref report 'managed_directory))))
            "library escaped selected managed directory"))
  (define root (collection-path "skia"))
  (define info (get-info/full root))
  (define source-identity (build-path root "private" "source-identity.json"))
  (write-json
   (hasheq 'schema 1 'status "passed" 'collection (path->string root)
           'source_version (info 'version) 'source_identity
           (and (file-exists? source-identity) (call-with-input-file source-identity read-json))
           'racket_version (version) 'os (symbol->string (system-type 'os))
           'architecture (symbol->string (system-type 'arch)) 'vm (symbol->string (system-type 'vm))
           'pointer_bits (system-type 'word) 'target (path->string (system-library-subpath #f))
           'text_load_order (if draw-first? "draw-first" "skia-first")
           'skia (hash-set skia 'loader skia-loader) 'harfbuzz harfbuzz
           'shapes shapes 'pixels_verified #t 'png_roundtrip_verified #t
           'draw_text_verified #t 'default_font_verified #t))
  (newline))
